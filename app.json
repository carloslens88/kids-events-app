{
  "expo": {
    "name": "Peque-Eventos",
    "slug": "kids-events-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kidseventsapp",
    "userInterfaceStyle": "automatic",
    "locales": {
      "es": "./assets/locales/es.json",
      "en": "./assets/locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.jhenigc.pequeeventos",
      "supportsTablet": true
    },
    "android": {
      "package": "com.jhenigc.pequeeventos",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte eventos infantiles cerca de ti."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
